{
  "name": "groq-chat",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "scripts": {
    "ng": "ng",
    "start": "python3 -m pip install -r backend/requirements.txt && python3 -m uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-3000}",
    "start:prod": "python3 -m uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-3000}",
    "dev": "concurrently \"ng serve --proxy-config proxy.conf.json\" \"python3 -m uvicorn backend.app:app --host 127.0.0.1 --port 3000 --reload --env-file .env\"",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "python -m pytest backend/test_app.py",
    "install:python": "python -m pip install -r backend/requirements.txt",
    "install:dev": "python -m pip install -r backend/requirements.txt pytest"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "mammoth": "^1.13.0",
    "ngx-markdown": "^22.1.1",
    "pdfjs-dist": "^6.5.438",
    "rxjs": "~7.8.0",
    "shiki": "^4.6.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/node": "^26.6.6",
    "concurrently": "^9.2.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
